# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service role: solo lato server, non finisce mai nel browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# dominio pubblico dell'app (serve al magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Notifiche Telegram — solo per l'admin, facoltative
# Crea il bot con @BotFather, poi scrivigli una volta e leggi il tuo chat id da
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_ADMIN_CHAT_ID=123456789
# protegge l'endpoint del cron
CRON_SECRET=una-frase-a-caso-lunga
# La Redazione — parola d'ordine del bookmarklet che importa la giornata.
# La stessa stringa va dentro il preferito: la genera /admin/redazione.
REDAZIONE_IMPORT_SECRET=un-altra-frase-a-caso-lunga
# Modello che scrive le notizie (Google AI Studio, piano gratuito)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest
# Facoltativo: il cookie di una sessione di fantacalcio.it, copiato dal
# browser. Serve solo se la raccolta dei voti torna vuota perché la pagina li
# mostra soltanto a chi è collegato.
FANTACALCIO_COOKIE=
# Facoltativo: l'id di stagione del live di fantacalcio.it (21 = 2026/27).
# L'app lo calcola da sé; serve solo se un anno il conto non torna.
FANTACALCIO_SEASON_ID=
# Facoltativo: il token di Leghe Fantacalcio. Di solito si incolla da
# /admin/redazione e sta nel database; questa variabile è il ripiego.
LEGHE_TOKEN=
# Facoltativo: la app_key di Leghe Fantacalcio, se il sito la cambia.
LEGHE_APP_KEY=
# Facoltativo: «no» spegne il calcolo automatico della giornata su Leghe
# Fantacalcio (il cron allora aspetta che la calcoli l'admin).
LEGHE_CALCOLO_AUTOMATICO=
